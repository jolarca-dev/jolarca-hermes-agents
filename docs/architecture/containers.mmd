                Website["website<br/>agent:jolarca:website<br/>Site composition from<br/>gated artefacts<br/>Gate: editorial"]
            end
        end

        subgraph GovernanceLayer["Governance Infrastructure"]
            Schemas["Schemas (schemas/)<br/>agent.schema.json<br/>policy.schema.json<br/>provenance.schema.json"]
